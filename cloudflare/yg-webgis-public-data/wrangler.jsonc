{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "yg-webgis-public-data-local",
  "main": "src/main.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "local",
    "GITHUB_ORIGIN": "https://webgisyg.id",
    "APPS_SCRIPT_BASE": "https://script.google.com/macros/s/AKfycbxUe4QyBvSiL9UJsL-nsJ5XrohDabwqhYYR9q5CTgLYiW1ZCfVy429iMlpU-lCDUSvvRg/exec"
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_SNAPSHOTS",
      "bucket_name": "yg-webgis-public-snapshots-local"
    }
  ],
  "env": {
    "staging": {
      "name": "yg-webgis-public-data-staging",
      "workers_dev": true,
      "ratelimits": [
        { "name": "DRONE_ASSET_LIMIT", "namespace_id": "26101811", "simple": { "limit": 20, "period": 60 } },
        { "name": "DRONE_ANALYSIS_LIMIT", "namespace_id": "26101812", "simple": { "limit": 2, "period": 60 } },
        { "name": "DRONE_LEGACY_LIMIT", "namespace_id": "26101813", "simple": { "limit": 120, "period": 60 } },
        { "name": "DRONE_SUBMIT_LIMIT", "namespace_id": "26101814", "simple": { "limit": 8, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "DRONE_R2_ACCOUNT_ID": "f521af5ec1f2197e8f55d1e460c0296e",
        "DRONE_R2_BUCKET": "yg-webgis-public-snapshots-staging",
        "GITHUB_ORIGIN": "https://webgisyg.id",
        "APPS_SCRIPT_BASE": "https://script.google.com/macros/s/AKfycbxUe4QyBvSiL9UJsL-nsJ5XrohDabwqhYYR9q5CTgLYiW1ZCfVy429iMlpU-lCDUSvvRg/exec"
      },
      "r2_buckets": [
        {
          "binding": "PUBLIC_SNAPSHOTS",
          "bucket_name": "yg-webgis-public-snapshots-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DRONE_QUEUE",
            "class_name": "DroneQueue"
          }
        ]
      }
    },
    "production": {
      "name": "yg-webgis-public-data",
      "workers_dev": true,
      "ratelimits": [
        { "name": "DRONE_ASSET_LIMIT", "namespace_id": "26101821", "simple": { "limit": 20, "period": 60 } },
        { "name": "DRONE_ANALYSIS_LIMIT", "namespace_id": "26101822", "simple": { "limit": 2, "period": 60 } },
        { "name": "DRONE_LEGACY_LIMIT", "namespace_id": "26101823", "simple": { "limit": 120, "period": 60 } },
        { "name": "DRONE_SUBMIT_LIMIT", "namespace_id": "26101824", "simple": { "limit": 8, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "DRONE_R2_ACCOUNT_ID": "f521af5ec1f2197e8f55d1e460c0296e",
        "DRONE_R2_BUCKET": "yg-webgis-public-snapshots",
        "GITHUB_ORIGIN": "https://webgisyg.id",
        "APPS_SCRIPT_BASE": "https://script.google.com/macros/s/AKfycbxUe4QyBvSiL9UJsL-nsJ5XrohDabwqhYYR9q5CTgLYiW1ZCfVy429iMlpU-lCDUSvvRg/exec"
      },
      "r2_buckets": [
        {
          "binding": "PUBLIC_SNAPSHOTS",
          "bucket_name": "yg-webgis-public-snapshots"
        }
      ],
      "routes": [
        {
          "pattern": "webgis-api.yayasangambut.org",
          "custom_domain": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DRONE_QUEUE",
            "class_name": "DroneQueue"
          }
        ]
      }
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DRONE_QUEUE",
        "class_name": "DroneQueue"
      }
    ]
  },
  "migrations": [
    {
      "tag": "drone-queue-v1",
      "new_sqlite_classes": [
        "DroneQueue"
      ]
    }
  ]
}
